{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streyn",
  "version": "1.0.0",
  "identifier": "de.labtoso.streyn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "externalBin": ["binaries/streyn-server"],
    "publisher": "LabtosoStudios",
    "copyright": "© LabtosoStudios",
    "category": "Music",
    "shortDescription": "Streyn",
    "longDescription": "Desktop app for your own Streyn server.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
